{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-6",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2fa5c150-0192-452a-88e3-0962f30f57b8","database_name": "web-app-6" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0ab15c6ef9c64292939722d393ca88a5" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
